# Copie para .env e preencha. NUNCA comite o .env.

# Ambiente: development | production | test
NODE_ENV=development
PORT=3000

# URL pública da aplicação. Usada no link do email de reset de senha e no CORS.
APP_URL=http://localhost:3000

# Postgres (Neon). Formato:
# postgresql://USUARIO:SENHA@HOST/BANCO?sslmode=require
DATABASE_URL=

# Segredo de assinatura dos JWT. Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Validade do token
JWT_EXPIRES_IN=7d

# Google Identity Services — Client ID do projeto no Google Cloud Console
GOOGLE_CLIENT_ID=

# SMTP para email de recuperação de senha (Gmail: use senha de app)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UNIMAP <noreply@unimap.edu.br>
