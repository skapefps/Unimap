{
  "name": "unimap-backend",
  "version": "1.0.0",
  "description": "Backend do sistema UNIMAP - gestão acadêmica",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migrations/run.js",
    "migrate:data": "node scripts/migrate-data.js",
    "seed": "node scripts/seed.js",
    "test": "NODE_ENV=test jest --runInBand",
    "test:watch": "NODE_ENV=test jest --runInBand --watch"
  },
  "keywords": [
    "unimap",
    "academico",
    "gestao"
  ],
  "author": "Arthur Roque",
  "license": "ISC",
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.1",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0"
  }
}
